{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}