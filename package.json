{
  "name": "backend-app",
  "packageManager": "yarn@4.12.0",
  "version": "1.0.0",
  "description": "api for the senpai app.",
  "keywords": [
    "api",
    "fastfy",
    "node",
    "js",
    "typescript"
  ],
  "license": "ISC",
