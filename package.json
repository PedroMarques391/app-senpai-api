{
  "name": "senpai-figurinhas-api",
  "packageManager": "yarn@4.12.0",
  "version": "1.0.0",
  "description": "api for the senpai app.",
  "keywords": [
    "api",
    "fastfy",
    "node",
    "js",
    "typescript"
  ],
  "license": "ISC",
  "author": "Pedro Marques",
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.4",
    "cloudinary": "^2.10.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "mongodb": "^7.5.0",
    "redis": "^6.2.1",
    "uuid": "^13.0.0",
    "zod": "^4.2.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "start": "node --env-file=.env dist/index.js",
    "dev": "tsup --watch --onSuccess \"node --env-file=.env dist/index.js\"",
    "up:development": "docker compose up -d",
    "up:prod": "docker compose up -d redis api",
    "up:build": "docker compose up -d --build",
    "up:db": "docker compose up -d mongo redis",
    "down": "docker compose down"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}